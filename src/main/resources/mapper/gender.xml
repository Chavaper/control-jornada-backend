<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.GenderMapper">

    <resultMap id="genderMap" type="cl.bennu.controljornadabackend.model.Gender">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <sql id="sqlGender">
        <!-- @formatter:off -->
        SELECT
            g.id
            , g.name
        FROM gender g
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="genderMap">
        <include refid="sqlGender"/>
    </select>

    <select id="get" resultMap="genderMap" parameterType="java.lang.Long">
        <include refid="sqlGender"/>
        WHERE g.id = #{id}
    </select>

</mapper>