<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.MaritalStatusMapper">

    <resultMap id="maritalStatusMap" type="cl.bennu.controljornadabackend.model.MaritalStatus">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <sql id="sqlMaritalStatus">
        <!-- @formatter:off -->
        SELECT
            ms.id
            , ms.name
        FROM marital_status ms
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="maritalStatusMap">
        <include refid="sqlMaritalStatus"/>
    </select>

    <select id="get" resultMap="maritalStatusMap" parameterType="java.lang.Long">
        <include refid="sqlMaritalStatus"/>
        WHERE ms.id = #{id}
    </select>

    <insert id="insert" parameterType="cl.bennu.controljornadabackend.model.MaritalStatus" keyProperty="id" useGeneratedKeys="true">
        <!-- @formatter:off -->
        INSERT INTO marital_status (
            name
        ) VALUES (
            #{name}
        )
        <!-- @formatter:on -->
    </insert>

    <update id="update" parameterType="cl.bennu.controljornadabackend.model.MaritalStatus">
        <!-- @formatter:off -->
        UPDATE marital_status SET
            name = #{name}
        WHERE id = #{id}
        <!-- @formatter:on -->
    </update>

    <delete id="deleteById">
        DELETE FROM marital_status WHERE id = #{id}
    </delete>

</mapper>